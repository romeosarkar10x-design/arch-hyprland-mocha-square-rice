{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Use <Button> from the design system instead of <button>."
          },
          {
            "element": "input",
            "message": "Use <Slider> from the design system instead of <input>."
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/bar/Bar/**",
              "components/bar/BarSegment/**",
              "components/bar/Tooltip/**",
              "components/bar/Workspaces/**",
              "components/controls/Button/**",
              "components/controls/IconButton/**",
              "components/controls/Slider/**",
              "components/controls/Toggle/**",
              "components/data/CoreGrid/**",
              "components/data/Gauge/**",
              "components/data/Graph/**",
              "components/data/Meter/**",
              "components/data/Sparkline/**",
              "components/data/StackBar/**",
              "components/data/Stat/**",
              "components/data/Visualizer/**",
              "components/desktop/BrowserView/**",
              "components/desktop/CodeView/**",
              "components/desktop/Desktop/**",
              "components/desktop/Terminal/**",
              "components/desktop/Wallpaper/**",
              "components/desktop/WindowFrame/**",
              "components/foundations/Icon/**",
              "components/foundations/IconTile/**",
              "components/foundations/Kbd/**",
              "components/foundations/Shortcut/**",
              "components/foundations/Surface/**",
              "components/foundations/Unit/**",
              "components/overlays/Launcher/**",
              "components/overlays/PowerMenu/**",
              "components/overlays/Toast/**",
              "components/overlays/ToastStack/**",
              "components/popups/AudioPanel/**",
              "components/popups/Calendar/**",
              "components/popups/ClockPanel/**",
              "components/popups/CpuPanel/**",
              "components/popups/GpuPanel/**",
              "components/popups/MediaPlayer/**",
              "components/popups/MemoryPanel/**",
              "components/popups/NetworkPanel/**",
              "components/popups/Panel/**",
              "components/popups/PanelSection/**",
              "components/popups/QuickSettings/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:MonoLisa))/i]",
        "message": "Font not provided by the design system. Available: MonoLisa."
      },
      {
        "selector": "JSXOpeningElement[name.name='AudioPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:outputs|output|volume|muted|micVolume|track|onOutputChange|onVolumeChange|className|key|ref|className|style|children)$/]",
        "message": "<AudioPanel> doesn't accept that prop. Declared props: outputs, output, volume, muted, micVolume, track, onOutputChange, onVolumeChange, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bar'] > JSXAttribute > JSXIdentifier[name!=/^(?:left|center|right|className|style|key|ref|className|style|children)$/]",
        "message": "<Bar> doesn't accept that prop. Declared props: left, center, right, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarSegment'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|children|accent|level|spark|divider|open|variant|dim|onClick|label|className|key|ref|className|style|children)$/]",
        "message": "<BarSegment> doesn't accept that prop. Declared props: icon, children, accent, level, spark, divider, open, variant, dim, onClick, label, className."
      },

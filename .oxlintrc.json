{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "import"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    "storybook-static/**",
    "node_modules/**"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": [
          "**/*.css"
        ]
      }
    ]
  },
  // The kit (converted from the old compiled bundle) predates these React Compiler rules;
  // keep them visible as warnings until its hooks are reworked.
  "overrides": [
    {
      "files": [
        "src/ui/**"
      ],
      "rules": {
        "react/immutability": "warn",
        "react/purity": "warn",
        "react/refs": "warn",
        "react/set-state-in-effect": "warn",
        "react-hooks/exhaustive-deps": "warn"
      }
    }
  ]
}

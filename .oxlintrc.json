{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "import"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    "_ds_bundle.js",
    "_preview/**",
    "_vendor/**",
    "components/**",
    "storybook-static/**",
    "node_modules/**"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": [
          "**/*.css"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/hyprland-ui.ts"
      ],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    }
  ]
}
